{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Skylist provides the scammer list, scammer UI, themes, and live cosmetic player customizations.",
  "authors": [
    "Vyriv"
  ],
  "icon": "assets/playerlist/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.ryan.playerlist.PlayerListMod"
    ],
    "modmenu": [
      "dev.ryan.playerlist.SkylistModMenuApi"
    ]
  },
  "mixins": [
    "playerlist.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "${minecraft}",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
